FROM golang:1.25.3-alpine AS builder
LABEL author="Emiliano Rizzonelli (emiliano.rizzonelli@proton.me)"
LABEL maintainer="Emiliano Rizzonelli (emiliano.rizzonelli@proton.me)"

WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY ./cmd ./cmd
COPY ./internal ./internal

RUN CGO_ENABLED=0 GOOS=linux go build -o /log-ingestor ./cmd/server/main.go
ARG VERSION
ARG COMMIT
ARG BUILD_DATE

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-X main.Version=${VERSION} -X main.Commit=${COMMIT} -X main.BuildDate=${BUILD_DATE}" \
    -o /log-ingestor ./cmd/server/main.go

FROM alpine:3.20

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /log-ingestor .

EXPOSE 8080

ENTRYPOINT ["./log-ingestor"]
